---
import Base from '../../../layouts/Base.astro';
import LogTable from '../../../components/LogTable.astro';
import TagList from '../../../components/TagList.astro';
import { allTags, getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), tags: allTags(posts) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
  tags: { tag: string; count: number }[];
}
const { tag, posts, tags } = Astro.props;
---

<Base title={`Posts tagged ${tag}`} description={`Revision log entries tagged ${tag}.`} sheet="LOG">
  <section class="section tag-page" aria-labelledby="tag-title">
    <div class="head">
      <a href="/log/" class="back label">← Revision log</a>
      <div class="eyebrow">Tag · {posts.length} {posts.length === 1 ? 'entry' : 'entries'}</div>
      <h1 id="tag-title" class="section-title">{tag}</h1>
      <TagList tags={tags} current={tag} />
    </div>
    <LogTable posts={posts} showDescription />
  </section>
</Base>

<style>
  .tag-page {
    border-bottom: 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 48px;
  }
  .back {
    align-self: flex-start;
    padding: 10px 0;
  }
  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }
  h1.section-title {
    font-size: clamp(48px, 8vw, 104px);
    overflow-wrap: anywhere;
  }
</style>
