---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/ibm-plex-sans/400';
import '@fontsource/ibm-plex-sans/400-italic';
import '@fontsource/ibm-plex-sans/500';
import '@fontsource/ibm-plex-sans/600';
import '@fontsource/ibm-plex-mono/400';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';
import Header from '../components/Header.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Shown in the footer title block, e.g. "HOME" or "LOG-003" */
  sheet?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, sheet = 'HOME', type = 'website' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Revision log`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.author} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0d2b4e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3efe4" media="(prefers-color-scheme: light)" />

    <!-- Apply a saved theme choice before paint to avoid a flash. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {
      SITE.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sheet">
      <div class="frame">
        <div class="ruler" aria-hidden="true">
          {['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'].map((l) => <span>{l}</span>)}
        </div>
        <Header />
        <main id="main">
          <slot />
        </main>
        <TitleBlock sheet={sheet} />
      </div>
    </div>
  </body>
</html>

<style>
  .ruler {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-bottom: 1px solid rgba(var(--line), var(--l-mid));
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .ruler span {
    padding: 7px 0;
    text-align: center;
    border-right: 1px solid rgba(var(--line), 0.2);
  }
  .ruler span:last-child {
    border-right: 0;
  }
  @media (max-width: 760px) {
    .ruler {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      font-size: 10px;
    }
    .ruler span:nth-child(n + 5) {
      display: none;
    }
    .ruler span:nth-child(4) {
      border-right: 0;
    }
  }
</style>
